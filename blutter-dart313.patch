diff --git a/blutter/src/pch.h b/blutter/src/pch.h
index 6fe72e9..f552dd4 100644
--- a/blutter/src/pch.h
+++ b/blutter/src/pch.h
@@ -112,4 +112,34 @@ namespace dart {
 #  define DartGetRecordType(record) record.GetRecordType()
 #endif
 
+// ---------------------------------------------------------------------------
+// Dart >= 3.13 closure layout
+// ---------------------------------------------------------------------------
+// UntaggedClosure used to declare named fields for the trailing variable-length
+// data (delayed_type_arguments / context / ...), so the generated offsets header
+// exported AOT_Closure_context_offset and
+// AOT_Closure_delayed_type_arguments_offset as *fixed* offsets.
+//
+// In newer engines the trailing data is a single variable-length array starting
+// at AOT_Closure_elements_start_offset, and the meaning of each slot depends on
+// the closure's flags (raw_object.h -> UntaggedClosure::ContextIndex()):
+//
+//   data[0] = delayed type arguments   (present iff has_delayed_type_args)
+//   data[1] = instantiator type args   (present iff class is generic)
+//   data[2] = function type arguments
+//   ...     = captured values / context
+//
+// The two legacy constants therefore both collapse onto "the first slot of the
+// trailing data", which is exactly AOT_Closure_elements_start_offset. For the
+// two places blutter uses them (recognising the prologue's closure-context and
+// closure-type-argument loads) that is the right address: in a closure with no
+// type arguments the context lands at data[0], and the delayed-type-arguments
+// load also targets data[0].
+#ifndef AOT_Closure_delayed_type_arguments_offset
+#  define AOT_Closure_delayed_type_arguments_offset AOT_Closure_elements_start_offset
+#endif
+#ifndef AOT_Closure_context_offset
+#  define AOT_Closure_context_offset AOT_Closure_elements_start_offset
+#endif
+
 #endif //PCH_H
